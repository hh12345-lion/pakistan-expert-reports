# Site URL (canonical)
NEXT_PUBLIC_SITE_URL=https://www.pakistanexpertreports.com

# Google Sheets — set these in Netlify Site settings → Environment variables
# The Next.js route /api/submit-lead writes a row when all three are present.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# Paste the full PEM. Use literal \n for newlines, or a multiline value. Quotes are stripped at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_spreadsheet_id
GOOGLE_SHEET_TAB_NAME=Sheet1

# Analytics & marketing (loaded only after cookie consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Search engine verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
